# Copie este archivo como ".env" (en la misma carpeta que app.py) y ajuste
# los valores según su instalación de MySQL/XAMPP. El servidor lo lee
# automáticamente al iniciar; no hace falta exportar variables a mano.
#
# Para saber si Flask está logrando conectarse, con el servidor corriendo
# abra en el navegador: http://127.0.0.1:5000/api/estado-bd

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=almuerzos_conscientes

# Opcional: base MySQL en la nube que exige conexión cifrada (TLS),
# por ejemplo TiDB Serverless (host, puerto 4000, usuario y contraseña
# que entrega su consola). Descargue el archivo ca.pem de la consola
# y colóquelo en la raíz del proyecto.
# DB_SSL=1
# DB_SSL_CA=tidb_ca.pem

# Opcional: clave para las sesiones de administrador/docente.
# SECRET_KEY=cambia-esto-por-un-valor-propio

# Opcional: dirección desde la que otros dispositivos (celulares) accederán
# al QR de registro, por ejemplo la IP de esta computadora en la red del colegio.
# PUBLIC_BASE_URL=http://192.168.1.20:5000
